NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/success-online.sqlite
# For Supabase, set DATABASE_URL to the PostgreSQL transaction-pooler URI (port 6543).
# Leave blank to use local SQLite. These values are server-only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=case-documents
SUPABASE_DOWNLOAD_BUCKET=case-downloads
# Used only by explicit database setup. Setup creates/updates configured accounts.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_SALES_USERNAME=
INITIAL_SALES_PASSWORD=
INITIAL_BACKOFFICE_USERNAME=
INITIAL_BACKOFFICE_PASSWORD=
STORAGE_PATH=./demo-integrations
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Demo integrations are enabled by default. Set to live only after configuring credentials privately.
DRIVE_MODE=demo
SHEETS_MODE=demo
PAYMENT_MODE=demo

# Google production placeholders. Do not commit real values.
GOOGLE_AUTH_MODE=shared_drive_or_oauth
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ROOT_FOLDER_ID=
GOOGLE_OPERATIONS_SPREADSHEET_ID=

# Payment gateway production placeholders.
PAYMENT_GATEWAY=razorpay_or_cashfree
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
