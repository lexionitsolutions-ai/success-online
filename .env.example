NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/success-online.sqlite
# For Supabase, set DATABASE_URL to the PostgreSQL transaction-pooler URI (port 6543).
# Leave blank to use local SQLite. These values are server-only.
DATABASE_URL=
# Download the SSL root certificate from Supabase Database settings if required.
DATABASE_CA_CERT_PATH=
# For Vercel, use certificate PEM contents rather than a local file path.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=case-documents
SUPABASE_DOWNLOAD_BUCKET=case-downloads
# Must not exceed the project's global Storage file size limit.
SUPABASE_DOWNLOAD_MAX_BYTES=50000000
# Used only by explicit database setup. Setup creates/updates configured accounts.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_SALES_USERNAME=
INITIAL_SALES_PASSWORD=
INITIAL_BACKOFFICE_USERNAME=
INITIAL_BACKOFFICE_PASSWORD=
STORAGE_PATH=./demo-integrations
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Demo integrations are enabled by default. Set to live only after configuring credentials privately.
SHEETS_MODE=demo
TEST_PRICING_MODE=true
# Legacy PAYMENT_MODE is ignored; direct UPI always requires manual verification.

# Optional SMS detection pilot. Empty values disable intake and evidence queries.
# Generate one 32-byte hex key per Android phone; never put production keys in Git.
# Example shape only: {"kotak-phone":"<64 random hex characters>"}
SMS_OBSERVER_KEYS=
# Owner-supplied Worldline BQR terminal, confirmed against the merchant account.
SMS_OBSERVER_TERMINAL=
# For single-use merchant-phone enrollment, enable the detector and set KEYS to {}.
SMS_OBSERVER_ENABLED=false
# Server-only JSON: {"tokenHash":"<sha256>","deviceId":"success-kotak-phone","expiresAt":"<ISO UTC>"}
SMS_OBSERVER_ENROLLMENT=
# Owner-authorized SMS-based automatic confirmation; exact RRN/amount/window match only.
SMS_AUTO_CONFIRM=false
# Unique 1-99 paise checkout adjustment enables automatic reference capture.
SMS_UNIQUE_AMOUNT=false

# Google production placeholders. Do not commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OPERATIONS_SPREADSHEET_ID=
